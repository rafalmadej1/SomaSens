# ⚠️  CRITICAL: All these variables MUST be set in production
# Never commit actual values to git

# Google Gemini AI API Key
# Get from: https://aistudio.google.com/app/apikeys
GOOGLE_API_KEY=your-google-api-key

# JWT Secret Key - MUST be strong and random (min 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-random-key-min-32-chars-change-me-in-production

# JWT issuer and audience used to scope access tokens
JWT_ISSUER=somasense-api
JWT_AUDIENCE=somasense-client

# Allowed CORS Origins (comma-separated)
# In production, set to your frontend domain only
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database URL (optional, defaults to sqlite)
DATABASE_URL=sqlite:///./fitness_app.db

# Environment (development, staging, production)
ENVIRONMENT=development
